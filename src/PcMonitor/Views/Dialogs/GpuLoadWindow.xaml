<Window x:Class="PcMonitor.Views.Dialogs.GpuLoadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:PcMonitor.Controls"
        Title="Нагрузка на видеокарту — авто-тест"
        Width="1100" Height="700" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Topmost="True" ShowInTaskbar="True"
        FontFamily="Segoe UI" Foreground="{DynamicResource TextBrush}">
    <Grid>
        <ctrl:GpuStressSurface x:Name="Surface" />

        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Padding="14,10"
                Background="{DynamicResource PanelBg}" CornerRadius="10">
            <StackPanel>
                <TextBlock x:Name="PhaseText" Text="Нагрузка на видеокарту" FontSize="18" FontWeight="Bold" />
                <TextBlock x:Name="StatsText" Foreground="{DynamicResource TextDimBrush}" FontSize="12" Margin="0,4,0,0"
                           Text="подготовка…" />
                <TextBlock x:Name="RemainingText" Foreground="{DynamicResource TextFaintBrush}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Button Content="Прервать" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14"
                Padding="14,6" Click="Abort_Click" />
    </Grid>
</Window>
