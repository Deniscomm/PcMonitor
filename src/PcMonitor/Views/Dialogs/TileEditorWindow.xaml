<Window x:Class="PcMonitor.Views.TileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Плитка дашборда" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="18">

        <TextBlock Text="Что показывать" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBox x:Name="SearchBox" TextChanged="Search_Changed" Margin="0,0,0,6"
                 ToolTip="Поиск по названию метрики, устройства или датчика" />
        <ComboBox x:Name="MetricBox" Height="30" Padding="8,4" MaxDropDownHeight="320" />

        <TextBlock Text="Своё название (необязательно)" FontWeight="SemiBold" Margin="0,14,0,6" />
        <TextBox x:Name="TitleBox" Padding="8,5" />

        <TextBlock Text="Вид плитки" FontWeight="SemiBold" Margin="0,14,0,6" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="VisualValue" Style="{StaticResource PillRadio}" GroupName="Visual"
                         Content="Значение" Tag="Value" IsChecked="True" />
            <RadioButton x:Name="VisualGauge" Style="{StaticResource PillRadio}" GroupName="Visual"
                         Content="Круговая шкала" Tag="Gauge" />
            <RadioButton x:Name="VisualBar" Style="{StaticResource PillRadio}" GroupName="Visual"
                         Content="Полоса" Tag="Bar" />
            <RadioButton x:Name="VisualGraph" Style="{StaticResource PillRadio}" GroupName="Visual"
                         Content="График" Tag="Graph" />
        </StackPanel>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Ширина, px" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="WidthBox" Text="260" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Высота, px" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="HeightBox" Text="150" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <TextBlock Text="Порог, жёлтый" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="WarningBox" Padding="8,5" />
            </StackPanel>
            <StackPanel Grid.Column="6">
                <TextBlock Text="Порог, красный" Foreground="{DynamicResource TextDimBrush}" Margin="0,0,0,4" />
                <TextBox x:Name="CriticalBox" Padding="8,5" />
            </StackPanel>
        </Grid>

        <CheckBox x:Name="HistoryCheck" Content="Показывать график истории" IsChecked="True" Margin="0,14,0,0" />
        <TextBlock x:Name="HintText" Foreground="{DynamicResource TextDimBrush}" TextWrapping="Wrap"
                   Margin="0,10,0,0"
                   Text="Пороги задаются в единицах метрики: например, 70 и 85 для температур, 100 для процентов." />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Отмена" Click="Cancel_Click" Margin="0,0,8,0" Padding="14,5" />
            <Button Content="Сохранить" Click="Ok_Click" Padding="14,5" />
        </StackPanel>
    </StackPanel>
</Window>

