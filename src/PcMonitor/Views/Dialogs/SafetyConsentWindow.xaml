<Window x:Class="PcMonitor.Views.SafetyConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PC Monitor" Width="560" SizeToContent="Height" MinHeight="300"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
    <Border Margin="18" Padding="22" Background="{DynamicResource PanelBg}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button x:Name="LanguageButton" DockPanel.Dock="Right" Content="РУ" Padding="7,3"
                        MinWidth="42" FontSize="11" Click="LanguageButton_Click" ToolTip="Сменить язык" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
            </DockPanel>
            <TextBlock x:Name="MessageText" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextDimBrush}" />
            <TextBlock x:Name="DisclaimerText" Margin="0,14,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarnBrush}" />
            <TextBlock x:Name="RestrictionText" Margin="0,12,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextDimBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="DeclineButton" Content="Отказаться" MinWidth="120" Padding="12,7"
                        Click="DeclineButton_Click" />
                <Button x:Name="AcceptButton" Content="Принять" MinWidth="120" Padding="12,7"
                        Margin="8,0,0,0" Click="AcceptButton_Click" />
            </StackPanel>
            <TextBlock x:Name="AcceptedText" Margin="0,18,0,0" TextWrapping="Wrap"
                       Foreground="Gray" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
