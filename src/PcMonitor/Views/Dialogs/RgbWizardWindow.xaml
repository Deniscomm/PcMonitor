<Window x:Class="PcMonitor.Views.Dialogs.RgbWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проверка подсветки (RGB / ARGB) — мастер"
        Width="900" Height="640" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12">
    <DockPanel Margin="18">

        <TextBlock DockPanel.Dock="Top" Text="Проверка подсветки" FontSize="17" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,12"
                   Text="Мастер показывает эталонный цвет или режим на экране, а вы сравниваете с тем, что делают ваши устройства. Для каждого режима ответьте «совпадает», «не совпадает» или «нет такого устройства». Ответы попадут в отчёт." />

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource ChromeBg}" CornerRadius="8" Padding="12"
                Margin="0,12,0,0">
            <DockPanel>
                <TextBlock x:Name="ProgressText" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}" />
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Сохранить отчёт" Click="SaveReport_Click" />
                    <Button Content="Закрыть" Click="Close_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <!-- Эталон -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" x:Name="ModeText" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Top" x:Name="ModeHint" Foreground="{DynamicResource TextDimBrush}"
                               Margin="0,4,0,10" TextWrapping="Wrap" />
                    <Border x:Name="Preview" CornerRadius="10" Margin="0,0,0,12" MinHeight="220"
                            Background="#202020" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Совпадает" Click="Match_Click" Margin="0" Padding="20,8" />
                        <Button Content="Не совпадает" Click="Mismatch_Click" Padding="20,8" />
                        <Button Content="Нет такого" Click="NotApplicable_Click" Padding="20,8" />
                    </StackPanel>
                    <Grid />
                </DockPanel>
            </Border>

            <!-- Список режимов и устройств -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Режимы" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ItemsControl x:Name="ModeList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Margin="0,2" Foreground="{DynamicResource TextDimBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Какие устройства проверяем" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Программы управления подсветкой" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock x:Name="SoftwareHint" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Text="Подсветкой управляет программа производителя: переключите в ней режим и сравните с эталоном на экране." />
                        <ItemsControl x:Name="SoftwareList" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,2">
                                        <Button DockPanel.Dock="Right" Content="Запустить" Padding="8,2" FontSize="11"
                                                Click="LaunchSoftware_Click" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Найти программы заново" Click="DetectSoftware_Click" Margin="0,8,0,0" />

                        <TextBlock Text="Результаты" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBox x:Name="ResultsBox" IsReadOnly="True" AcceptsReturn="True" Height="150"
                                 TextWrapping="Wrap" Background="{DynamicResource InputBg}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>

