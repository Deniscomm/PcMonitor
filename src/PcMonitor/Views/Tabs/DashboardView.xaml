<UserControl x:Class="PcMonitor.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PcMonitor.Controls"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <ContextMenu x:Key="TileMenu">
            <MenuItem Header="Настроить…" Click="EditTile_Click" />
            <MenuItem Header="Дублировать" Click="DuplicateTile_Click" />
            <MenuItem Header="Сбросить историю" Click="ResetTileHistory_Click" />
            <Separator />
            <MenuItem Header="Удалить плитку" Click="RemoveTile_Click" />
        </ContextMenu>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel>
                    <Button Content="Добавить плитку" Click="AddTile_Click" Margin="0" />
                    <Button Content="Набор по умолчанию" Click="DefaultTiles_Click" />
                    <Button Content="Сбросить историю" Click="ResetHistory_Click" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Период графика:" VerticalAlignment="Center" Margin="14,0,6,0"
                               Foreground="{DynamicResource TextDimBrush}" />
                    <ComboBox x:Name="PeriodBox" Width="132" SelectedIndex="3" SelectionChanged="Period_Changed">
                        <ComboBoxItem Content="10 секунд" Tag="10" />
                        <ComboBoxItem Content="30 секунд" Tag="30" />
                        <ComboBoxItem Content="60 секунд" Tag="60" />
                        <ComboBoxItem Content="2 минуты" Tag="120" />
                        <ComboBoxItem Content="5 минут" Tag="300" />
                        <ComboBoxItem Content="10 минут" Tag="600" />
                        <ComboBoxItem Content="За всё время" Tag="0" />
                    </ComboBox>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextDimBrush}"
                           Text="Перетаскивайте плитки мышью · правый клик — настройка, дублирование, удаление" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TileHost">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="{Binding Config.Width}" Height="{Binding Config.Height}" Margin="0,0,12,12"
                                Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14,12" Cursor="SizeAll"
                                ContextMenu="{StaticResource TileMenu}"
                                MouseLeftButtonDown="Tile_MouseDown" MouseMove="Tile_MouseMove"
                                MouseLeftButtonUp="Tile_MouseUp">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Accent}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" FontSize="11.5"
                                               Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ctrl:GaugeControl Visibility="{Binding ShowGauge, Converter={StaticResource BoolToVisibility}}"
                                                       Fraction="{Binding Progress}" ValueText="{Binding ValueText}"
                                                       Accent="{Binding Accent}" />

                                    <StackPanel VerticalAlignment="Center"
                                                Visibility="{Binding ShowValue, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ValueText, Mode=OneWay}" FontSize="26" FontWeight="Bold"
                                                   Foreground="{Binding Accent}" MinWidth="140"
                                                   HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="None" />
                                    </StackPanel>

                                    <ctrl:Sparkline Visibility="{Binding IsGraphOnly, Converter={StaticResource BoolToVisibility}}"
                                                    Values="{Binding History}" LineBrush="{Binding Accent}"
                                                    Unit="{Binding Unit}" MetricType="{Binding MetricType}" Format="0.#" />
                                </Grid>

                                <ctrl:Sparkline Grid.Row="2" Height="34" Margin="0,8,0,0" Format="0.#" Compact="True"
                                                Values="{Binding History}" LineBrush="{Binding Accent}"
                                                Unit="{Binding Unit}" MetricType="{Binding MetricType}"
                                                Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Grid.Row="3" Text="{Binding SubText}" FontSize="10.5" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextFaintBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>

