<UserControl x:Class="PcMonitor.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <DockPanel>
        <Border DockPanel.Dock="Top" Margin="0,0,0,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Запустить всё" Click="RunAll_Click" Margin="0" />
                    <Button Content="Процессор" Click="RunCpu_Click" />
                    <Button Content="Память" Click="RunMemory_Click" />
                    <Button Content="Диск" Click="RunDisk_Click" />
                    <Button Content="Стоп" Click="Stop_Click" />
                </StackPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                           Text="бенчмарки запускаются в реальном времени, результаты сохраняются в историю" />
                <Grid />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <StackPanel>
                    <TextBlock Text="Ход выполнения" FontWeight="SemiBold" />
                    <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,10,0,0" />
                    <TextBlock x:Name="CurrentText" Foreground="{DynamicResource TextDimBrush}" Margin="0,8,0,0"
                               TextWrapping="Wrap" Text="готов к запуску" />
                    <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="Как читать результаты" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                               Text="Процессор — миллионы операций в секунду (больше лучше). Память — ГБ/с и наносекунды задержки. Диск — МБ/с и IOPS. Сравнивайте прогоны между собой: после разгона или смены настроек баллы должны расти." />
                    <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="Размер файла теста диска берётся из настроек (вкладка «Настройки»)." TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFaintBrush}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Результаты" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Content="Экспорт" Click="Export_Click" />
                            <Button Content="Очистить историю" Click="Clear_Click" />
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" CanUserAddRows="False" RowHeight="24"
                              Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="1" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2431">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Когда" Binding="{Binding StartedText}" Width="140" />
                            <DataGridTextColumn Header="Тест" Binding="{Binding DisplayName}" Width="*" MinWidth="200" />
                            <DataGridTextColumn Header="Значение" Binding="{Binding ValueText}" Width="110" />
                            <DataGridTextColumn Header="Единица" Binding="{Binding Unit}" Width="100" />
                            <DataGridTextColumn Header="Балл" Binding="{Binding Score}" Width="90" />
                            <DataGridTextColumn Header="Время" Binding="{Binding Duration, StringFormat=mm\\:ss}" Width="80" />
                            <DataGridTextColumn Header="Примечание" Binding="{Binding DisplayDetails}" Width="320" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>

