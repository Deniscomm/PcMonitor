<UserControl x:Class="PcMonitor.Views.GpuTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PcMonitor.Controls"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- Сцена нагрузки -->
        <Border Grid.Column="0" Background="#0A0C12" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <Grid>
                <ctrl:GpuStressSurface x:Name="Surface" />

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Padding="12,8"
                        Background="#CC101725" CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="FpsText" Text="FPS: —" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="OverlayText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   Text="тест не запущен" />
                    </StackPanel>
                </Border>

                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="12,8"
                        Background="#CC101725" CornerRadius="8">
                    <StackPanel>
                        <TextBlock x:Name="GpuTempText" Text="GPU: —" FontSize="13" />
                        <TextBlock x:Name="GpuExtraText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   Text="мощность и частоты появятся при запуске" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Панель управления -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Нагрузка видеокарты" FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Уровень нагрузки" Foreground="{DynamicResource TextDimBrush}" />
                        <Slider x:Name="LoadSlider" Minimum="1" Maximum="12" Value="8" TickFrequency="1"
                                IsSnapToTickEnabled="True" ValueChanged="Load_Changed" Margin="0,4,0,0" />

                        <TextBlock Text="Длительность этапа" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,0" />
                        <ComboBox x:Name="StageBox" SelectedIndex="1" Margin="0,4,0,0">
                            <ComboBoxItem Content="5 секунд" Tag="5" />
                            <ComboBoxItem Content="10 секунд" Tag="10" />
                            <ComboBoxItem Content="30 секунд" Tag="30" />
                            <ComboBoxItem Content="1 минута" Tag="60" />
                        </ComboBox>

                        <CheckBox x:Name="InfiniteBox" Content="Без ограничения времени — до «Стоп»"
                                  Margin="0,12,0,0" />
                        <TextBlock Text="Только стресс-нагрузка: длительность этапа задаёт интервал проверки, сцена работает непрерывно. Бенчмарки остаются ограниченными. Автостоп GPU ≥ 85 °C / CPU ≥ 95 °C."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" Margin="0,6,0,0" />
                        <TextBlock Text="Проверка артефактов" Foreground="{DynamicResource TextDimBrush}" Margin="0,12,0,0" />
                        <TextBlock Text="Кадр сравнивается с эталонным: расхождения — признак сбоев GPU."
                                   Foreground="{DynamicResource TextFaintBrush}" FontSize="11" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Content="Стресс-тест" Click="StartStress_Click" Margin="0" />
                            <Button Content="Бенчмарк" Click="StartBenchmark_Click" />
                            <Button Content="Стоп" Click="Stop_Click" />
                        </StackPanel>

                        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,14,0,0"
                                     BorderThickness="0" />
                        <TextBlock x:Name="ProgressText" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0"
                                   Text="готов к запуску" TextWrapping="Wrap" />

                        <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="Direct3D-бенчмарк (без привязки к герцовке монитора)"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="AdapterText" Foreground="{DynamicResource TextFaintBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,4,0,8" Text="определяю видеокарту…" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Пресет" VerticalAlignment="Center" />
                            <ComboBox x:Name="D3DPresetBox" Grid.Column="1" SelectedIndex="1">
                                <ComboBoxItem Content="Low (720p)" />
                                <ComboBoxItem Content="Medium (1080p)" />
                                <ComboBoxItem Content="High (1440p)" />
                                <ComboBoxItem Content="Extreme (4K)" />
                            </ComboBox>
                            <TextBlock Grid.Column="3" Text="Сцена" VerticalAlignment="Center" />
                            <ComboBox x:Name="D3DSceneBox" Grid.Column="4" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Запустить D3D-бенчмарк" Click="RunD3DBenchmark_Click" Margin="0" />
                            <Button Content="Проверка стабильности" Click="RunD3DStability_Click" />
                        </StackPanel>
                        <ProgressBar x:Name="D3DProgress" Height="8" Minimum="0" Maximum="1" Margin="0,10,0,0"
                                     BorderThickness="0" />
                        <TextBlock x:Name="D3DStatusText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Сцены рисуются в offscreen-текстуры: 60 FPS — не предел, результат не зависит от монитора." />

                        <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="Мониторинг во время теста" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <TextBlock x:Name="StageTempText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   Text="температура: —" />
                        <ctrl:Sparkline x:Name="TempChart" Height="46" Margin="0,6,0,0" Compact="True" Format="0" Unit="°C" />
                        <TextBlock x:Name="StageFpsText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   Margin="0,8,0,0" Text="частота кадров: —" />
                        <ctrl:Sparkline x:Name="FpsChart" Height="46" Margin="0,6,0,0" Compact="True" Format="0" Unit="FPS" />

                        <Separator Margin="0,14,0,10" Background="{DynamicResource BorderBrush}" />

                        <TextBlock Text="История прогонов" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <DataGrid x:Name="RunsGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="190"
                                  HeadersVisibility="Column" CanUserAddRows="False" RowHeight="22"
                                  Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"
                                  BorderThickness="1" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E2431">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Когда" Binding="{Binding StartedText}" Width="130" />
                                <DataGridTextColumn Header="Режим" Binding="{Binding Mode}" Width="110" />
                                <DataGridTextColumn Header="FPS ср." Binding="{Binding FpsAverage, StringFormat=0.0}" Width="70" />
                                <DataGridTextColumn Header="Макс. °C" Binding="{Binding TemperatureMaximum, StringFormat=0.0}" Width="70" />
                                <DataGridTextColumn Header="Артефакты" Binding="{Binding Artifacts}" Width="80" />
                                <DataGridTextColumn Header="Оценка" Binding="{Binding Score}" Width="70" />
                                <DataGridTextColumn Header="Итог" Binding="{Binding ResultText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Очистить историю" Click="ClearHistory_Click" Margin="0" />
                            <Button Content="Экспорт отчёта" Click="ExportReport_Click" />
                        </StackPanel>

                        <TextBlock x:Name="LogText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

