<UserControl x:Class="PcMonitor.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PcMonitor.Controls"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <ContextMenu x:Key="TileMenu">
            <MenuItem Header="Настроить…" Click="EditTile_Click" />
            <MenuItem Header="Дублировать" Click="DuplicateTile_Click" />
            <MenuItem Header="Сбросить историю" Click="ResetTileHistory_Click" />
            <Separator />
            <MenuItem Header="Удалить плитку" Click="RemoveTile_Click" />
        </ContextMenu>
        <Style x:Key="TileCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="14" Margin="6,0,6,12">
            <StackPanel>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="AddButton" Content="＋ Добавить плитку" Click="AddTile_Click" Padding="14,8" />
                        <Button x:Name="ResetButton" Content="Сбросить историю" Click="ResetHistory_Click" Padding="12,8" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock x:Name="PeriodLabel" Text="Период графика:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDimBrush}" Margin="0,0,8,0" />
                    <ComboBox x:Name="PeriodBox" Width="150" SelectionChanged="Period_Changed">
                        <ComboBoxItem Content="10 секунд" Tag="10" />
                        <ComboBoxItem Content="30 секунд" Tag="30" />
                        <ComboBoxItem Content="60 секунд" Tag="60" />
                        <ComboBoxItem Content="2 минуты" Tag="120" />
                        <ComboBoxItem Content="5 минут" Tag="300" />
                        <ComboBoxItem Content="10 минут" Tag="600" />
                        <ComboBoxItem Content="За всё время" Tag="0" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TileHost" Margin="6,0,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TileCard}" Width="{Binding Config.Width}" Height="{Binding Config.Height}"
                                ContextMenu="{StaticResource TileMenu}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0">
                                    <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Accent}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" Margin="9,0,0,0" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextDimBrush}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{Binding Accent}" FontSize="9" />
                                </DockPanel>

                                <Grid Grid.Row="1" Margin="0,8,0,0">
                                    <ctrl:GaugeControl Visibility="{Binding ShowGauge, Converter={StaticResource BoolToVisibility}}"
                                                       Fraction="{Binding Progress}" ValueText="{Binding ValueText}" Accent="{Binding Accent}" />
                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowValue, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ValueText}" FontSize="30" FontWeight="Bold" Foreground="{Binding Accent}"
                                                   HorizontalAlignment="Center" TextAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding ValueText}" FontSize="26" FontWeight="Bold" Foreground="{Binding Accent}" HorizontalAlignment="Center" />
                                        <ProgressBar Height="10" Margin="4,8,4,0" Minimum="0" Maximum="1"
                                                     Value="{Binding Progress, Mode=OneWay}" Foreground="{Binding ProgressBrush}"
                                                     Background="{DynamicResource PanelAltBg}" />
                                    </StackPanel>
                                    <ctrl:Sparkline Visibility="{Binding IsGraphOnly, Converter={StaticResource BoolToVisibility}}"
                                                    Values="{Binding History}" LineBrush="{Binding Accent}" Unit="{Binding Unit}"
                                                    MetricType="{Binding MetricType}" Format="0.#" />
                                    <TextBlock Text="—" FontSize="30" FontWeight="Bold" Foreground="{Binding Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding ShowMissingValue, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <ctrl:Sparkline Grid.Row="2" Height="28" Margin="0,4,0,0" Compact="True"
                                                Values="{Binding History}" LineBrush="{Binding Accent}" Unit="{Binding Unit}"
                                                MetricType="{Binding MetricType}"
                                                Visibility="{Binding ShowSparkline, Converter={StaticResource BoolToVisibility}}" />
                                <DockPanel Grid.Row="3" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SubText}" Foreground="{DynamicResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
