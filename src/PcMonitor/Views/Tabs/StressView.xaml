<UserControl x:Class="PcMonitor.Views.StressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PcMonitor.Views"
             xmlns:ctrl="clr-namespace:PcMonitor.Controls"
             Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12">
    <TabControl x:Name="InnerTabs" SelectionChanged="InnerTabs_SelectionChanged">

        <TabItem Header="Стресс-тесты CPU / памяти / диска">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Каталог -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Каталог тестов" FontWeight="SemiBold" />
                            <TextBlock x:Name="TestCountText" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextDimBrush}" FontSize="11" />
                        </DockPanel>
                        <ComboBox x:Name="CategoryBox" DockPanel.Dock="Top" Margin="0,0,0,8"
                                  SelectionChanged="Category_Changed" />
                        <ListBox x:Name="TestList" SelectionChanged="TestList_SelectionChanged" />
                    </DockPanel>
                </Border>

                <!-- Прогон -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="TitleText" Text="Выберите тест" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextDimBrush}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Потоки (0 — все ядра)" VerticalAlignment="Center" />
                                <TextBox x:Name="ThreadsBox" Grid.Column="1" Text="0" Padding="8,5" />
                                <TextBlock Grid.Column="3" Text="Память теста, МБ" VerticalAlignment="Center" />
                                <TextBox x:Name="MemoryBox" Grid.Column="4" Padding="8,5" />
                                <TextBlock Grid.Column="6" Text="Файл теста диска, МБ" VerticalAlignment="Center" />
                                <TextBox x:Name="DiskBox" Grid.Column="7" Padding="8,5" />
                            </Grid>

                            <CheckBox x:Name="InfiniteBox" Content="Без ограничения времени — до нажатия «Стоп»"
                                      Margin="0,12,0,0" Checked="Duration_Changed" Unchecked="Duration_Changed" />
                            <CheckBox x:Name="DiskConsentBox" Content="Разрешаю запись временных файлов дисковых тестов"
                                      Margin="0,8,0,0" />
                            <TextBlock Text="Бессрочно запускается только выбранный тест. Запись на SSD увеличивает износ; автостоп CPU ≥ 95 °C / GPU ≥ 85 °C."
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaintBrush}" FontSize="11" Margin="0,6,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="Запустить тест" Click="RunTest_Click" Margin="0" />
                                <Button x:Name="RunCategoryButton" Content="Вся категория" Click="RunCategory_Click" />
                                <Button x:Name="RunAllButton" Content="Все тесты" Click="RunAll_Click" />
                                <Button Content="Стоп" Click="Stop_Click" />
                                <Button Content="Экспорт отчёта" Click="Export_Click" />
                            </StackPanel>

                            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,14,0,0" />
                            <TextBlock x:Name="ProgressText" Foreground="{DynamicResource TextDimBrush}" Margin="0,6,0,0"
                                       TextWrapping="Wrap" Text="готов к запуску" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock x:Name="TempText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                               Text="температура процессора: —" />
                                    <ctrl:Sparkline x:Name="TempChart" Height="44" Margin="0,4,0,0" Compact="True" Format="0" Unit="°C" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="ErrorsText" Foreground="{DynamicResource TextDimBrush}" FontSize="11"
                                               Text="ошибки: 0" />
                                    <ctrl:Sparkline x:Name="ThroughputChart" Height="44" Margin="0,4,0,0" Compact="True"
                                                    Format="0.#" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Журнал прогона" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ScrollViewer x:Name="LogScroll" Height="150" VerticalScrollBarVisibility="Auto">
                                <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextDimBrush}"
                                         FontFamily="Consolas" FontSize="11" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Результаты" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" CanUserAddRows="False" RowHeight="24"
                                      Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"
                                      BorderThickness="1" GridLinesVisibility="None"
                                      HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Когда" Binding="{Binding StartedText}" Width="140" />
                                    <DataGridTextColumn Header="Тест" Binding="{Binding TestName}" Width="*" MinWidth="180" />
                                    <DataGridTextColumn Header="Категория" Binding="{Binding CategoryText}" Width="120" />
                                    <DataGridTextColumn Header="Этапы" Binding="{Binding StageCount}" Width="70" />
                                    <DataGridTextColumn Header="Ошибки" Binding="{Binding TotalErrors}" Width="80" />
                                    <DataGridTextColumn Header="Средняя скорость" Binding="{Binding ThroughputText}" Width="140" />
                                    <DataGridTextColumn Header="Время" Binding="{Binding DurationText}" Width="80" />
                                    <DataGridTextColumn Header="Итог" Binding="{Binding VerdictText}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="GPU-нагрузка">
            <views:GpuTestView x:Name="GpuTest" />
        </TabItem>

        <TabItem Header="Бенчмарки (CPU / память / диск)">
            <views:BenchmarkView x:Name="Benchmarks" />
        </TabItem>
    </TabControl>
</UserControl>

