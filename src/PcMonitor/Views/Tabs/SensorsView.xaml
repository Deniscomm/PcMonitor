<UserControl x:Class="PcMonitor.Views.SensorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctrl="clr-namespace:PcMonitor.Controls"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Левая колонка: фильтры -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Устройства" FontWeight="SemiBold" Margin="2,0,0,6" />
                <ListBox x:Name="HardwareList" DockPanel.Dock="Top" Height="180"
                         SelectionChanged="Hardware_SelectionChanged" />

                <TextBlock DockPanel.Dock="Top" Text="Типы датчиков" FontWeight="SemiBold" Margin="2,12,0,6" />
                <ScrollViewer DockPanel.Dock="Top" MaxHeight="240" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TypeFilters">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Checked="TypeFilter_Changed" Unchecked="TypeFilter_Changed" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <CheckBox x:Name="OnlyWithValuesCheck" Content="Только датчики с данными"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="HideThresholdsCheck" Content="Скрывать датчики-пороги"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="HideImplausibleCheck" Content="Скрывать недостоверные значения"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <TextBlock Foreground="{DynamicResource TextDimBrush}" FontSize="10.5" TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Text="Правый клик по датчику — переименовать, скрыть, не учитывать в сводке или вынести на дашборд плиткой." />
                </StackPanel>

                <Grid />
            </DockPanel>
        </Border>

        <!-- Таблица и график -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="Поиск:" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"
                           Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Width="300" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
                <TextBlock x:Name="Counters" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                <Grid />
            </DockPanel>

            <DataGrid x:Name="SensorGrid" Grid.Row="1"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="None" HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                      Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1" RowHeight="24" EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      SelectionChanged="SensorGrid_SelectionChanged">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Не учитывать в сводке" Click="ToggleIgnore_Click" />
                        <MenuItem Header="Скрыть датчик" Click="ToggleHidden_Click" />
                        <Separator />
                        <MenuItem Header="Пометить достоверным" Click="MarkReliable_Click" />
                        <MenuItem Header="Пометить недостоверным" Click="MarkUnreliable_Click" />
                        <MenuItem Header="Доверие: автоматическое" Click="ResetPlausibility_Click" />
                        <Separator />
                        <MenuItem Header="Переименовать…" Click="Rename_Click" />
                        <MenuItem Header="Переименовать по имени железа" Click="RenameByHardware_Click" />
                        <Separator />
                        <MenuItem Header="Создать плитку на дашборде" Click="CreateTile_Click" />
                        <Separator />
                        <MenuItem Header="Сбросить правила для всех датчиков" Click="ResetRules_Click" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ToolTip" Value="{Binding Tooltip}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                <Setter Property="Background" Value="#3A1D24" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsIgnored}" Value="True">
                                <Setter Property="Opacity" Value="0.5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Устройство" Binding="{Binding Hardware}" Width="220" />
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeName}" Width="110" />
                    <DataGridTextColumn Header="Датчик" Binding="{Binding DisplayName}" Width="*" MinWidth="170" />
                    <DataGridTemplateColumn Header="Значение" Width="200" SortMemberPath="Value">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding ValueText}" Foreground="{Binding ValueBrush}"
                                               FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Height="5" CornerRadius="2.5" Background="{DynamicResource PanelAltBg}"
                                            VerticalAlignment="Center" Margin="6,0,0,0"
                                            Visibility="{Binding HasBar, Converter={StaticResource BoolToVisibility}}">
                                        <Border HorizontalAlignment="Left" Width="{Binding BarWidth}"
                                                Background="{Binding BarBrush}" CornerRadius="2.5" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Минимум" Binding="{Binding MinText}" Width="115" SortMemberPath="Min" />
                    <DataGridTextColumn Header="Максимум" Binding="{Binding MaxText}" Width="115" SortMemberPath="Max" />
                    <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Margin="0,10,0,0" Padding="14,10" Height="240">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="ChartStats" DockPanel.Dock="Right"
                                   Foreground="{DynamicResource TextDimBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ChartTitle" Text="График: выберите датчик в таблице"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ctrl:Sparkline x:Name="Chart" Margin="0,10,0,0" Format="0.0" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

