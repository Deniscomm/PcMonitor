<Window x:Class="PcMonitor.Views.OsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Мониторинг ПК — оверлей"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">
    <Border x:Name="Root" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="10" Padding="12,10">
        <StackPanel>
            <DockPanel x:Name="HeaderRow" Margin="0,0,0,6">
                <TextBlock x:Name="HeaderTitle" Text="МОНИТОРИНГ ПК" FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextDimBrush}" />
                <TextBlock x:Name="HeaderRight" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           FontSize="10.5" Foreground="{DynamicResource TextFaintBrush}" />
            </DockPanel>
            <StackPanel x:Name="RowsHost" />
        </StackPanel>
    </Border>
</Window>
