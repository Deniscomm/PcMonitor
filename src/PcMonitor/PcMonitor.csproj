<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Требуется для значка в области уведомлений (трей). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PcMonitor</AssemblyName>
    <RootNamespace>PcMonitor</RootNamespace>
    <StartupObject>PcMonitor.Program</StartupObject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>1.0.0</Version>
    <Product>PC Monitor</Product>
    <Company>Deniscomm (Discord)</Company>
    <Authors>Deniscomm (Discord)</Authors>
    <Copyright>© Deniscomm (Discord)</Copyright>
    <AssemblyTitle>Мониторинг ПК</AssemblyTitle>
    <Description>Мониторинг всех датчиков компьютера: температуры, напряжения, вентиляторы, нагрузки, частоты, мощности.</Description>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
    <NeutralLanguage>ru-RU</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только для значка в трее: убираем его глобальные using,
         иначе типы Brush, Point, Application конфликтуют с WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Localization\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>



